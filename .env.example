# --- WhatsApp Cloud API (Meta developer portal -> your app -> WhatsApp -> API Setup) ---
# dry_run = log replies instead of sending (no credentials needed). cloud = real WhatsApp.
WHATSAPP_MODE=dry_run
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me
GRAPH_API_VERSION=v21.0

# --- Token provider: mock (demo) or queuepro (real Token Management API) ---
TOKEN_PROVIDER=mock
# Leave empty to use the mock mounted inside this app; or point at a standalone mock.
MOCK_TOKEN_API_URL=
QUEUEPRO_TOKEN_API_URL=
QUEUEPRO_API_KEY=

# Mock behaviour, for testing error handling
MOCK_LATENCY_MS=0
MOCK_FAILURE_RATE=0
MOCK_CLOSED_BRANCHES=

# --- Sessions: memory (single process) or redis (multiple workers / restarts) ---
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=600

# Comma-separated WhatsApp numbers allowed to request tokens. Empty = everyone.
AUTHORIZED_NUMBERS=

ENABLE_SIMULATOR=true
LOG_LEVEL=INFO
